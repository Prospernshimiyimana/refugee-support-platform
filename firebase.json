{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": [
      {
        "collection": "news",
        "queryScope": "COLLECTION",
        "fields": [
          {
            "fieldPath": "status",
            "order": "ASCENDING"
          },
          {
            "fieldPath": "createdAt",
            "order": "DESCENDING"
          }
        ]
      }
    ]
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
